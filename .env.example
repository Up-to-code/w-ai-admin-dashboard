# Convex - required for production
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud

# Optional - deployment selector (for npx convex dev/deploy)
CONVEX_DEPLOYMENT=dev:<your-deployment>

# Feature flags
NEXT_PUBLIC_EXTENDED_CAMPAIGN_APIS=1
NEXT_PUBLIC_MANUAL_CATALOG_ENABLED=1

# Admin namespace (advanced - usually leave at 0)
NEXT_PUBLIC_ADMIN_NAMESPACE=0
NEXT_PUBLIC_ADMIN_NAMESPACE_STRICT=0
